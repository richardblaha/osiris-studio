{
  "name": "@osiris-studio/web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-served Osiris Studio runtime (OpenVSCode Server pattern).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "osiris-web": "./server/index.mjs"
  },
  "scripts": {
    "prepare:shell": "node scripts/clone-upstream.mjs && node scripts/apply-branding.mjs",
    "build": "node scripts/check-ready.mjs",
    "build:shell": "node scripts/build.mjs",
    "start": "node server/index.mjs",
    "lint": "eslint scripts server",
    "typecheck": "echo \"@osiris-studio/web: plain .mjs, nothing to typecheck\"",
    "test": "node --test \"scripts/**/*.test.mjs\" \"server/**/*.test.mjs\"",
    "clean": "rimraf .build"
  },
  "dependencies": {
    "@osiris-studio/branding": "workspace:*"
  },
  "devDependencies": {
    "eslint": "^9.12.0",
    "rimraf": "^6.0.1"
  }
}
