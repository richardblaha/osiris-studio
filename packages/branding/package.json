{
  "name": "@osiris-studio/branding",
  "displayName": "Osiris Branding",
  "version": "1.0.0",
  "description": "Osiris Studio branding: syncs icons, colour/file-icon themes, the master logo, watermarks and the bundled font from richardblaha/osiris-theme's current release, and carries the product.json overlay + shared asset metadata.",
  "license": "MIT",
  "publisher": "osiris-studio",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./product-overlay": "./product.overlay.json",
    "./metadata": "./assets/metadata.json",
    "./sync-theme": "./scripts/sync-theme.mjs",
    "./render-icons": "./scripts/render-icons.mjs",
    "./apply-to-checkout": "./scripts/apply-to-checkout.mjs",
    "./bundle-extensions": "./scripts/bundle-extensions.mjs"
  },
  "files": [
    "dist",
    "assets",
    "config",
    "product.overlay.json",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "sync:theme": "node scripts/sync-theme.mjs",
    "render:icons": "node scripts/render-icons.mjs",
    "lint": "eslint src scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo assets/generated assets/.theme-sync"
  },
  "devDependencies": {
    "@osiris-studio/tsconfig": "workspace:*",
    "@types/node": "^22.7.5",
    "eslint": "^9.12.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "dependencies": {
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4"
  }
}
